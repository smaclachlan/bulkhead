# Copy to .env (already gitignored) and fill in before `nix run .#up`.

# Required: Anthropic API key for the Orchestrator's LLM calls.
ANTHROPIC_API_KEY=

# Optional: pin the Chat MCP local UI token instead of letting it generate
# a random one at startup (printed in `docker compose logs chat-mcp` either
# way).
CHAT_MCP_TOKEN=

# Optional: OCI runtime for the Workspace container. Leave unset/"runc" on
# a checkout without Kata Containers installed. Set to "kata" once Kata is
# installed and registered as a Docker runtime (see README's Kata setup
# note) - docs/adr/0002-phase-2-isolation-ux-memory.md Decision 1.
WORKSPACE_RUNTIME=runc
