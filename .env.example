# Copy to .env (already gitignored) and fill in before `nix run .#up`.

# Required: Anthropic API key for the Orchestrator's LLM calls.
ANTHROPIC_API_KEY=

# Optional: pin the Chat MCP local UI token instead of letting it generate
# a random one at startup (printed in `docker compose logs chat-mcp` either
# way).
CHAT_MCP_TOKEN=

# Optional: OCI runtime for the Workspace container. Leave unset/"runc" on
# a checkout without Kata Containers installed. Set to "kata" once Kata is
# installed and registered as a Docker runtime (see README's Kata setup
# note) - docs/adr/0002-phase-2-isolation-ux-memory.md Decision 1.
WORKSPACE_RUNTIME=runc

# For Git MCP (docs/adr/0003-phase-3-git-mcp.md). Leaving these unset is
# fine - the stack still comes up and git-mcp's tools just report "not
# configured" until you set GIT_REMOTE_URL for real (see README's Git MCP
# setup section).

# SSH remote for the repo git-mcp clones into the shared workspace-repo
# volume and pushes to, e.g. git@github.com:your-org/your-repo.git
GIT_REMOTE_URL=

# Path on the HOST to a private SSH deploy key scoped to that one repo
# (read-only bind-mounted into git-mcp only - see ADR-0003 Decision 4).
# Never commit the key itself; this .env file is already gitignored.
GIT_SSH_DEPLOY_KEY_HOST_PATH=

# Optional: glob the agent's push_request branch must match, enforced
# server-side in git-mcp (ADR-0003 Decision 3/4). Default only allows
# pushing to branches under agent/.
GIT_PUSH_BRANCH_PATTERN=agent/*
