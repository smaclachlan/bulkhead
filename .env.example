# Copy to .env (already gitignored) and fill in before `nix run .#up`.

# Required: Anthropic API key for the Orchestrator's LLM calls.
ANTHROPIC_API_KEY=

# Optional: pin the Chat MCP local UI token instead of letting it generate
# a random one at startup (printed in `docker compose logs chat-mcp` either
# way).
CHAT_MCP_TOKEN=

# Optional: set to 1/true/yes to keep mcp-agent's own "[Calling tool X with
# args Y]" notices in the chat transcript instead of the Orchestrator
# stripping them by default. When kept, chat-mcp's browser UI and CLI both
# render those lines in italics to distinguish them from the actual reply.
CHAT_SHOW_TOOL_CALLS=

# Optional: OCI runtime for the Workspace container. Leave unset/"runc" on
# a checkout without Kata Containers installed. Set to "kata" once Kata is
# installed and registered as a Docker runtime (see README's Kata setup
# note) - docs/adr/0002-phase-2-isolation-ux-memory.md Decision 1.
WORKSPACE_RUNTIME=runc

# Optional: directory containing a Dockerfile to build as the Workspace
# image instead of the minimal default (coreutils, a shell, and git - see
# workspace/default.nix). Point this at your own project's build
# environment (README cornerstone 7 - "should contain the full build
# environment for the user's tooling setup"). `nix run .#up` still forces
# the container to idle for `docker exec` regardless of this image's own
# CMD/ENTRYPOINT (docker-compose.yml's `command:` override on `workspace`)
# - it only needs a POSIX shell and `sleep` present. Leave unset to keep
# the default minimal image.
WORKSPACE_DOCKERFILE_DIR=

# Optional: path to a file (never committed - keep it outside this repo, or
# gitignored like this one is) holding a build-time-only credential (e.g. a
# GitHub PAT) that a custom WORKSPACE_DOCKERFILE_DIR's Dockerfile needs to
# fetch a private git dependency during the image build (e.g. `west
# update`). Passed to `docker build` via BuildKit's --secret, never a
# --build-arg or a file baked into the image - never reaches any image
# layer, the container filesystem, or anything at runtime. See README's
# "Custom workspace image" section for the Dockerfile-side pattern that
# reads it. Leave unset if your build has no private dependencies.
WORKSPACE_BUILD_SECRET_HOST_PATH=
# The secret's id, as your Dockerfile's `RUN --mount=type=secret,id=...`
# names it. Defaults to workspace_build_token if unset - only worth
# overriding if your Dockerfile uses a different id.
WORKSPACE_BUILD_SECRET_ID=

# Optional: path INSIDE the containers where the Workspace's working tree
# lives. Leave unset for the default /repo.
WORKSPACE_REPO_PATH=

# Optional: host directory to bind-mount as the Workspace's working tree,
# instead of the default internal-only named volume. Useful for a large
# existing checkout you don't want to re-clone into the volume. Security
# relaxation: the container gets read/write access to this host path, not
# just an isolated Docker volume - leave unset unless you need it. If set,
# check the host directory is writable by the Workspace container's UID
# (see workspace/default.nix) or git ops inside it will fail with
# permission errors.
WORKSPACE_HOST_PATH=

# Optional: host-side port for the Chat UI (container side is always
# 8787). Only matters if you're running more than one Bulkhead stack
# concurrently under different profiles (`nix run .#up -- ./other.conf`)
# - each needs a distinct host port, or they'll fail to bind. Leave unset
# for the default 8787.
CHAT_UI_HOST_PORT=

# For Git MCP (docs/adr/0003-phase-3-git-mcp.md). Leaving these unset is
# fine - the stack still comes up and git-mcp's tools just report "not
# configured" until you set GIT_REMOTE_URL for real (see README's Git MCP
# setup section).

# SSH remote for the repo git-mcp clones into the shared workspace-repo
# volume and pushes to, e.g. git@github.com:your-org/your-repo.git
GIT_REMOTE_URL=

# Path on the HOST to a private SSH deploy key scoped to that one repo
# (read-only bind-mounted into git-mcp only - see ADR-0003 Decision 4).
# Never commit the key itself; this .env file is already gitignored.
GIT_SSH_DEPLOY_KEY_HOST_PATH=

# Optional: glob the agent's push_request branch must match, enforced
# server-side in git-mcp (ADR-0003 Decision 3/4). Default only allows
# pushing to branches under agent/.
GIT_PUSH_BRANCH_PATTERN=agent/*
